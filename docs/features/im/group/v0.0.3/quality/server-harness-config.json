{
  "project": {
    "kind": "rust",
    "source_roots": [
      "server/src",
      "server/modules/im-group/src",
      "server/modules/im-message/src",
      "server/modules/im-ws/src"
    ]
  },
  "commands": {
    "test": [
      "zsh",
      "-lc",
      "set -a; source server/.env; set +a; JWT_SECRET=feature-v003-harness cargo llvm-cov --manifest-path server/Cargo.toml --workspace --lcov --output-path docs/features/im/group/v0.0.3/quality/attempt-01/server.lcov"
    ],
    "static": [
      ["cargo", "fmt", "--manifest-path", "server/Cargo.toml", "--check"],
      ["cargo", "clippy", "--manifest-path", "server/Cargo.toml", "-p", "im-group", "-p", "im-ws", "-p", "im-message", "-p", "falsh-im", "--all-targets", "--", "-D", "warnings"]
    ]
  },
  "coverage": {
    "format": "lcov",
    "path": "docs/features/im/group/v0.0.3/quality/attempt-01/server.lcov",
    "scope": "changed",
    "threshold": 80
  }
}
